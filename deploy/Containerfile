# --- build stage: compile the Astro static site ---
FROM docker.io/library/node:20-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN npm run build

# --- runtime stage: serve dist/ with non-root nginx on :8080 (OpenShift-friendly) ---
FROM docker.io/nginxinc/nginx-unprivileged:1.27-alpine
USER root
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
# Allow an arbitrary (OpenShift-assigned) UID in group 0 to read content and write nginx temp/cache.
RUN chgrp -R 0 /usr/share/nginx/html /var/cache/nginx /etc/nginx \
 && chmod -R g=u /usr/share/nginx/html /var/cache/nginx /etc/nginx
USER 101
EXPOSE 8080
